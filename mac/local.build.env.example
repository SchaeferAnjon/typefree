# 本机私有构建参数。复制为 local.build.env（已在 .gitignore 里，绝不提交）。
# 没有这个文件也能编译：编出来的版本没有 7 天试用通道，只能在「设置 → 模型」填自己的 API Key。

# 试用代理服务器（IP + 自签证书）。留空 = 无试用通道。
VP_TRIAL_API_BASE=
# 服务器证书 DER 的 SHA-256（base64）：openssl x509 -in cert.pem -outform der | openssl dgst -sha256 -binary | base64
VP_TRIAL_CERT_SHA256=
# Developer ID 签名身份（留空 = 本地 ad hoc 签名，够自己用；发布需要）
DEVELOPER_ID_IDENTITY=
